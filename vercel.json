{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 300
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/BrandNavigator/?",
      "headers": {
        "Location": "/brand-navigator"
      },
      "status": 308
    },
    {
      "src": "/brandnavigator/?",
      "headers": {
        "Location": "/brand-navigator"
      },
      "status": 308
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ]
}
